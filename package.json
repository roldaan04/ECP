{
  "name": "ecp-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web de ECP · Emilio Congosto Pérez, preparador físico y entrenador personal en Madrid",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-content.mjs",
    "start": "node scripts/serve.mjs 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "images": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  }
}
