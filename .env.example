# URL pública del sitio (confirmar TLD: .com o .es)
NEXT_PUBLIC_SITE_URL=https://emiliocongostoperez.com
# true solo en el build de producción validado; cualquier otro valor = noindex en todo el sitio
NEXT_PUBLIC_INDEXING=false
# consultar | orientativo | publicado  (publicado exige pricing.validated = true)
NEXT_PUBLIC_PRICING_DISPLAY_MODE=consultar
# Endpoint externo del formulario (Formspree, Web3Forms…). Vacío = formulario oculto
NEXT_PUBLIC_FORM_ENDPOINT=
# Proveedor de analítica sin cookies: plausible | umami. Vacío = sin analítica
NEXT_PUBLIC_ANALYTICS=
